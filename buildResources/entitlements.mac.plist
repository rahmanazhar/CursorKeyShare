<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron/V8 need JIT and writable+executable memory under hardened runtime. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- Required because we load third-party / locally-built native .node modules
       (cursorkeyshare-native, uiohook-napi, nut.js). Without this, notarization
       rejects the nested unsigned binaries. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- NOTE: Accessibility and Input Monitoring are NOT entitlements. They are
       runtime TCC permissions the user grants in System Settings > Privacy &
       Security. There is no Info.plist key or entitlement that grants them. -->
</dict>
</plist>
